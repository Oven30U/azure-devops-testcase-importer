# Copia este archivo a ".env" (sin ".example") y completa tus valores.
# El archivo ".env" es local y personal: nunca lo compartas, lo pegues
# en un chat ni lo subas a un repositorio (agregalo a .gitignore).
#
# Ver README.md, seccion "Antes de empezar", para saber donde conseguir
# cada uno de estos datos en Azure DevOps.

# URL base de tu organizacion de Azure DevOps.
# Azure DevOps Services:         https://dev.azure.com/TU_ORGANIZACION
# Azure DevOps Server (on-prem): https://TU_SERVIDOR/TU_COLECCION
AZDO_URL=https://dev.azure.com/TU_ORGANIZACION

# Nombre del proyecto de Azure DevOps (respeta mayusculas/minusculas y espacios).
PROJECT=TU_PROYECTO

# Nombre del Test Plan. Solo se usa para mostrarlo en los logs.
TEST_PLAN_NAME=TU_TEST_PLAN

# IDs del Test Plan y la Test Suite destino (numericos).
# Se consiguen en la URL de Azure DevOps al abrir el Test Plan/Suite:
# .../_testPlans/execute?planId=65547&suiteId=65548
PLAN_ID=0
SUITE_ID=0

# Ruta completa al Excel con los casos de prueba.
EXCEL_FILE=C:\ruta\a\tu\Casos_de_Prueba.xlsx

# Nombre de la hoja del Excel que contiene los casos de prueba.
EXCEL_SHEET_NAME=Casos de prueba

# true procesa solo el primer caso del Excel (util para probar la
# configuracion antes de correr todo). false procesa todos los casos.
SOLO_PRIMER_CASO=false

# Version de la API REST de Azure DevOps.
API_VERSION=5.1

# Personal Access Token de Azure DevOps.
# OPCIONAL: si lo dejas vacio, el script te lo va a pedir por consola
# (oculto) cada vez que lo ejecutes, lo cual es mas seguro si varias
# personas comparten esta carpeta o esta maquina.
# Permisos requeridos: Work Items (Read & Write), Test Management (Read & Write)
AZDO_PAT=